# Set both variables after you provision Render PostgreSQL.
# DATABASE_URL: use the Internal direct URL (or Internal Pooler URL if pooling is enabled).
# DIRECT_URL: always use the Internal direct URL — this is what prisma migrate deploy uses.
DATABASE_URL=replace_with_render_internal_database_url
DIRECT_URL=replace_with_render_internal_direct_url
NODE_ENV=development
PORT=5000
